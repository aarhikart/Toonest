{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs"
    },
    "whatsapp-service": {
      "root": "services/whatsapp-service",
      "entrypoint": "dist/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}